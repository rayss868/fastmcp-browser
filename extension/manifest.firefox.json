{
  "manifest_version": 3,
  "name": "FastMCP Browser",
  "version": "0.1.4",
  "description": "Extension-native browser automation bridge without CDP.",
  "permissions": ["storage", "tabs", "scripting", "cookies", "downloads", "activeTab", "alarms", "webRequest", "webRequestFilterResponse"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["background.js"], "type": "module" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "FastMCP Browser", "default_popup": "status.html", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" } },
  "browser_specific_settings": { "gecko": { "id": "fastmcp-browser@example.local" } }
}
